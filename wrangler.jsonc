{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "homeworktrack-pro-v4",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homeworktrack",
      "database_id": "PUT_THE_NEW_DATABASE_ID_HERE",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
